{
	"name": "bordr",
	"description": "Read and drive every coding agent on your machine, from your phone. A mobile web workspace for herdr.",
	"private": true,
	"version": "1.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/AnnasCookies/bordr.git"
	},
	"homepage": "https://github.com/AnnasCookies/bordr#readme",
	"engines": {
		"bun": ">=1.2"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun scripts/assets-attic.ts stash && vite build && bun scripts/assets-attic.ts restore",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright install chromium && playwright test",
		"smoke": "bun run scripts/smoke.ts",
		"deploy": "bun run build && bun scripts/publish-build.ts && systemctl --user restart bordr && sleep 3 && bun run smoke \"${BORDR_URL:-http://127.0.0.1:7682/}\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/web-push": "^3.6.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"simple-icons": "^16.30.0",
		"svelte": "^5.56.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"dompurify": "^3.4.14",
		"marked": "^18.0.11",
		"shiki": "^4.4.3",
		"web-push": "^3.6.7"
	}
}
