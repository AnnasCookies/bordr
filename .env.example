# Copy to .env and edit. See README.md "Quickstart" and SECURITY.md.

# Path to the herdr session socket. Find yours with:
#   ls ~/.config/herdr/sessions/*/herdr.sock
HERDR_SOCKET=/home/youruser/.config/herdr/sessions/main/herdr.sock

# Where bordr listens. Keep loopback and put `tailscale serve` in front of it.
# bordr answers 503 to everything when this is unset or is anything other
# than loopback or a Tailscale address (100.64.0.0/10), because it has no
# login. See SECURITY.md.
HOST=127.0.0.1
PORT=7682

# Directories the Files tab may browse and serve, as comma-separated
# name:path pairs. Dotfiles are refused inside every root. Defaults to
# dev:~/Documents/Dev when unset.
#BORDR_FILE_ROOTS=dev:~/Dev,docs:~/Documents

# Web Push (optional). Generate a pair with: bunx web-push generate-vapid-keys
# Without these the bell in the app does nothing and /api/push returns 503.
#VAPID_PUBLIC_KEY=replace-me
#VAPID_PRIVATE_KEY=replace-me
#VAPID_SUBJECT=mailto:you@example.com

# Claude Code transcripts are read from ~/.claude by default; set this if you
# run Claude Code with a different config directory.
#CLAUDE_CONFIG_DIR=/home/youruser/.claude
# Likewise Codex rollouts are read from ~/.codex/sessions unless CODEX_HOME is set.
#CODEX_HOME=/home/youruser/.codex

# Where push subscriptions and read-state live. Defaults to ./.data under the
# working directory; the systemd unit moves it to ~/.local/state/bordr.
#BORDR_DATA_DIR=/home/youruser/.local/state/bordr

# svelte-adapter-bun caps request bodies at 512KB by default, which refuses
# every camera photo, and drops idle connections after 10s, which is tight for
# a slow first agent start. Bun reads this file when you run the build by
# hand; the systemd unit sets the same values.
BODY_SIZE_LIMIT=100M
IDLE_TIMEOUT=120

# Only needed behind a reverse proxy on your own domain: bordr answers only to
# loopback, its HOST, Tailscale addresses and *.ts.net names (see SECURITY.md).
#BORDR_ALLOWED_HOSTS=bordr.example.com

# Only set this if you have read SECURITY.md and are deliberately serving on
# an address that is neither loopback nor your tailnet.
#BORDR_I_UNDERSTAND_THIS_HAS_NO_AUTH=1
